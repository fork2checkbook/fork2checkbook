flowchart LR
    classDef verified fill:#dcfce7,stroke:#16803a,color:#12351f,stroke-width:2px
    classDef implemented fill:#dbeafe,stroke:#2563eb,color:#172554,stroke-width:2px
    classDef planned fill:#fef3c7,stroke:#d97706,color:#4a2b05,stroke-width:2px,stroke-dasharray:6 4
    classDef external fill:#f1f5f9,stroke:#64748b,color:#1e293b,stroke-width:2px
    classDef warning fill:#fff7ed,stroke:#ea580c,color:#431407,stroke-width:2px

    humanA["Issuer"]:::external
    humanB["Eventual holder"]:::external

    subgraph dockAZone["Dock A laptop"]
        webA["Human-first web dock"]:::verified
        walletA["Issuing dock wallet | example A"]:::verified
        bleA["Bleak dock central"]:::verified
        qvacA["Local QVAC typed intent"]:::verified
        webA --> walletA
        webA --> bleA
        qvacA -.-> webA
    end

    subgraph vaultZone["Trusted disposable-note vault"]
        notePolicy["Immutable plans and recovery journal"]:::verified
        noteN["Fresh note wallet N"]:::verified
        claim["Salted claim hash | first redemption wins"]:::warning
        notePolicy --> noteN
        notePolicy --> claim
    end

    subgraph physical["Offline physical zone"]
        billA["WEMOS bill | bearer capsule"]:::verified
        watch["Waveshare watch | bearer capsule"]:::verified
        billB["TTGO bill | bearer capsule"]:::verified
        billA <-.->|"BLE kind 04"| watch
        watch <-.->|"no dock or Internet"| billB
    end

    subgraph dockBZone["Dock B laptop"]
        bleB["Bleak extraction"]:::verified
        walletB["Holder-chosen wallet | example B"]:::verified
        settle["Exact txid + assignment + balance verifier"]:::verified
        qvacB["Local QVAC redeem intent"]:::verified
        bleB --> walletB --> settle
        qvacB -.-> walletB
    end

    chain["Bitcoin Mutinynet + Esplora"]:::external

    humanA --> dockAZone
    walletA -->|"RGB funding | 5 USDT"| noteN
    noteN --> chain
    notePolicy -->|"603-byte capsule"| bleA
    bleA -->|"GATT dock"| billA
    billB -->|"GATT dock extraction"| bleB
    noteN -->|"RGB redemption | 5 USDT"| walletB
    walletB --> chain
    humanB --> dockBZone

    noteTrust["Prototype trust: vault retains N keys; copied capsules race"]:::warning
    noteTrust -.-> vaultZone
