flowchart TB
    classDef board fill:#dbeafe,stroke:#2563eb,color:#172554,stroke-width:2px
    classDef peripheral fill:#dcfce7,stroke:#16803a,color:#12351f,stroke-width:2px
    classDef planned fill:#fef3c7,stroke:#d97706,color:#4a2b05,stroke-width:2px,stroke-dasharray:6 4
    classDef storage fill:#f1f5f9,stroke:#64748b,color:#1e293b,stroke-width:2px

    subgraph wemos["Bill A WEMOS LOLIN32"]
        boardA["ESP32-D0WDQ6 | 4 MB flash"]:::board
        oled["SSD1306 OLED | 128 by 64 | SDA21 SCL22"]:::peripheral
        led["Status LED | GPIO5"]:::peripheral
        button["TTP223 digital touch | GPIO12 active high | release at reset"]:::peripheral
        usbA["CP2104 USB UART | stable by-id path"]:::peripheral
        boardA --> oled
        boardA --> led
        boardA --> button
        usbA --> boardA
    end

    subgraph ttgo["Bill B TTGO LoRa32 V1.3"]
        boardB["ESP32 | 4 MB flash | LoRa unused"]:::board
        oledB["External SSD1306 OLED | 128 by 64 | SDA21 SCL22 | no reset"]:::peripheral
        touch["TTP223 digital touch | GPIO12 active high | release at reset"]:::peripheral
        usbB["CP2102 USB UART | stable by-id path"]:::peripheral
        boardB --> oledB
        boardB --> touch
        usbB --> boardB
    end

    subgraph watch["Wearable intermediary Waveshare ESP32-S3"]
        boardW["ESP32-S3 | 32 MB flash | 8 MB PSRAM"]:::board
        amoled["CO5300 AMOLED | 410 by 502"]:::peripheral
        touchW["FT3168 touch | one-shot receiver"]:::peripheral
        rtc["PCF85063 RTC | always-on demo clock"]:::peripheral
        flashW["SPIFFS 4 MiB | fail-closed recovery"]:::storage
        boardW --> amoled
        boardW --> touchW
        boardW --> rtc
        boardW --> flashW
    end

    radio["ESP32 BLE | dock peripheral and tap peer"]:::peripheral
    flash["Factory app 3 MiB | SPIFFS 896 KiB | no OTA"]:::storage
    boardA --> radio
    boardB --> radio
    boardW --> radio
    boardA --> flash
    boardB --> flash
